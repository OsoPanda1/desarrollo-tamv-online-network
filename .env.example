# Copy to .env.local for local development. Never use these placeholders in production.
# Keep this file free of real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Per-process PostgreSQL pool cap. Default: 3. Set according to provider limits,
# serverless instance concurrency, and whether DATABASE_URL uses a pooler.
# Accepted integer range: 1..20.
PG_POOL_MAX=3

# Shared fixed-window rate limits for public endpoints. Vercel production enables
# the limiter automatically; local development is disabled here by default.
# REQUIRED DEPLOY ORDER: on a verified staging DB, run `pnpm db:preflight`,
# `pnpm db:migrate`, then `pnpm db:preflight` again. Verify the migration is present
# before deploying to Vercel production OR explicitly enabling the limiter in any env.
# TAMV_RATE_LIMIT_SALT is REQUIRED whenever enabled. Use a unique, secret, high-entropy
# value of at least 32 characters per environment. Identity keys use HMAC-SHA-256;
# raw IPs are not persisted. Never use this placeholder as a real secret.
TAMV_RATE_LIMIT_ENABLED=false
TAMV_RATE_LIMIT_SALT=replace-with-a-random-per-environment-value

# Generate a unique high-entropy value (at least 32 characters) for each environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# TAMV Pass — intercambio de identidad firmado con infraestructura open source.
# No equivale a Vercel Passport en el edge ni a un servidor OIDC completo.
# Mantener apagado hasta configurar claves, audiences, migración del rate limit y revisión.
TAMV_PASS_ENABLED=false
# Origen HTTPS canónico del emisor (sin ruta). En producción es obligatorio.
TAMV_PASS_ISSUER=
# Lista separada por comas de orígenes HTTPS exactos autorizados como audiencia.
TAMV_PASS_ALLOWED_AUDIENCES=
# Base64 de una clave privada RSA en PEM PKCS#8, mínimo 2048 bits; se recomienda 3072.
# Generar y guardar en el gestor de secretos. Nunca guardar el PEM o el base64 en Git.
TAMV_PASS_PRIVATE_KEY_B64=
# Identificador de clave opcional; si se omite, se deriva del thumbprint de la clave pública.
TAMV_PASS_KEY_ID=
# Rotación opcional: base64 de PEM público SPKI anterior y su kid. Nunca poner aquí la clave privada.
TAMV_PASS_PREVIOUS_PUBLIC_KEY_B64=
TAMV_PASS_PREVIOUS_KEY_ID=

# Optional, one-time bootstrap only. Generate at least 32 random characters,
# configure it in the secret manager, use it once, then remove/rotate it.
TAMV_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-one-time-token

# Optional approved HTTPS hosted-checkout URL for the public support page.
# Accepted providers/hosts are allowlisted in app/apoyar/page.tsx.
# Leave empty until recipient, terms, fees and reporting policy are ready.
TAMV_DONATION_URL=

# Optional read-only bridge to the institutional research application.
# Set only after verifying the exact public HTTPS deployment URL.
# The URL must end at /api/research/search; no credentials or query parameters.
TAMV_INSTITUTIONAL_RESEARCH_SEARCH_URL=

# Canonical origin for authentication callbacks and Stripe return URLs.
# In production, use the final HTTPS origin (for example https://tamv.online).
APP_URL=http://localhost:3000

# Stripe subscription billing is deliberately DISABLED by default.
# Allowed values: disabled | test | live.
# Test mode is prohibited on Vercel production; never paste live keys in previews.
TAMV_BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The following approvals must only be set after the operator has completed
# the legal, privacy, tax and refund-policy review. They are NOT legal advice.
TAMV_MEMBERSHIP_TERMS_VERSION=
TAMV_MEMBERSHIP_PRIVACY_APPROVED=false
TAMV_MEMBERSHIP_LEGAL_APPROVED=false
TAMV_MEMBERSHIP_TAX_APPROVED=false
TAMV_MEMBERSHIP_REFUNDS_APPROVED=false

# Optional Stripe Tax. Keep disabled until Stripe Tax and the tax treatment have
# been configured for the actual operating entity and approved for launch.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_BEHAVIOR=


# LATAMV Governance System — disabled by default; never set true before security review.
LGS_FOUNDER_EMAIL=tamvonlinenetwork@outlook.es
LGS_FOUNDER_ACCESS_ENABLED=false
LGS_FOUNDER_SECURITY_REVIEW_APPROVED=false
# Configure the canonical specification only in the private server environment.
# Never prefix this variable with NEXT_PUBLIC_ or commit the actual specification.
LGS_CANONICAL_SPEC_MARKDOWN=
