# Copy to .env.local for local development. Never use these placeholders in production.
# Keep this file free of real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Per-process PostgreSQL pool cap. Default: 3. Set according to provider limits,
# serverless instance concurrency, and whether DATABASE_URL uses a pooler.
# Accepted integer range: 1..20.
PG_POOL_MAX=3

# Generate a unique high-entropy value (at least 32 characters) for each environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional, one-time bootstrap only. Generate at least 32 random characters,
# configure it in the secret manager, use it once, then remove/rotate it.
TAMV_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-random-one-time-token

# Optional approved HTTPS hosted-checkout URL for the public support page.
# Accepted providers/hosts are allowlisted in app/apoyar/page.tsx.
# Leave empty until recipient, terms, fees and reporting policy are ready.
TAMV_DONATION_URL=

# Canonical origin for authentication callbacks and Stripe return URLs.
# In production, use the final HTTPS origin (for example https://tamv.online).
APP_URL=http://localhost:3000

# Stripe subscription billing is deliberately DISABLED by default.
# Allowed values: disabled | test | live.
# Test mode is prohibited on Vercel production; never paste live keys in previews.
TAMV_BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The following approvals must only be set after the operator has completed
# the legal, privacy, tax and refund-policy review. They are NOT legal advice.
TAMV_MEMBERSHIP_TERMS_VERSION=
TAMV_MEMBERSHIP_PRIVACY_APPROVED=false
TAMV_MEMBERSHIP_LEGAL_APPROVED=false
TAMV_MEMBERSHIP_TAX_APPROVED=false
TAMV_MEMBERSHIP_REFUNDS_APPROVED=false

# Optional Stripe Tax. Keep disabled until Stripe Tax and the tax treatment have
# been configured for the actual operating entity and approved for launch.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TAX_BEHAVIOR=
